@@ -0,0 +1,29 @@
+package client
+
+import (
+	"sync"
+	"time"
+)
+
+// Bound status-triggered network traffic without caching live peer statistics
+// or the transport and Sync stream checks performed by IsHealthy.
+type healthProbeCache struct {
+	mu   sync.Mutex
+	next time.Time
+	err  error
+}
+
+func (p *healthProbeCache) run(now func() time.Time, probe func() error) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if now().Before(p.next) {
+		return p.err
+	}
+	p.err = probe()
+	interval := 30 * time.Second
+	if p.err != nil {
+		interval = 10 * time.Second
+	}
+	p.next = now().Add(interval)
+	return p.err
+}
