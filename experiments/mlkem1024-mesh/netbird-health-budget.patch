@@ -0,0 +1,50 @@
+package client
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestHealthProbeBudget(t *testing.T) {
+	var p healthProbeCache
+	clock := time.Unix(100, 0)
+	now := func() time.Time { return clock }
+	calls := 0
+	var failure error
+	probe := func() error { calls++; return failure }
+	p.run(now, probe)
+	clock = clock.Add(29 * time.Second)
+	p.run(now, probe)
+	if calls != 1 {
+		t.Fatal(calls)
+	}
+	clock = clock.Add(time.Second)
+	failure = errors.New("offline")
+	if p.run(now, probe) != failure || calls != 2 {
+		t.Fatal("did not probe at deadline")
+	}
+	clock = clock.Add(9 * time.Second)
+	if p.run(now, probe) != failure || calls != 2 {
+		t.Fatal("failure was not cached")
+	}
+	clock = clock.Add(time.Second)
+	failure = nil
+	if p.run(now, probe) != nil || calls != 3 {
+		t.Fatal("recovery was not detected")
+	}
+}
+func TestHealthProbeSingleFlight(t *testing.T) {
+	var p healthProbeCache
+	var wg sync.WaitGroup
+	calls := 0
+	for i := 0; i < 50; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); p.run(time.Now, func() error { calls++; return nil }) }()
+	}
+	wg.Wait()
+	if calls != 1 {
+		t.Fatal(calls)
+	}
+}
