+
+func (b TCPBudget) valid() bool { return b.Dial > 0 && b.Write > 0 && b.Receipt > 0 }
+
+// SetBudget sets the delivery budget for one authorized endpoint. A zero
+// budget restores the direct default.
+func (c *TCPConn) SetBudget(addr *net.UDPAddr, b TCPBudget) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if b.valid() {
+		c.budgets[addr.String()] = b
+	} else {
+		delete(c.budgets, addr.String())
+	}
+}
+// BudgetFor returns the delivery budget in effect for an endpoint.
+func (c *TCPConn) BudgetFor(addr *net.UDPAddr) TCPBudget {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if b, ok := c.budgets[addr.String()]; ok && b.valid() {
+		return b
+	}
+	if DirectTCPBudget.valid() {
+		return DirectTCPBudget
+	}
+	return TCPBudget{Dial: 3 * time.Second, Write: 3 * time.Second, Receipt: 3 * time.Second}
+}
