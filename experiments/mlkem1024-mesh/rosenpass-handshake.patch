+	// already past RespHello it completes (the peer answered it); the peer's
+	// crossing exchange is dropped and aborts when ours completes there.
+	if cur.nextMsg == msgTypeRespHello {
+		s.abortHandshakeLocked(p)
+		return true
+	}
+	return false
