@@ -0,0 +1,53 @@
+package rosenpass
+
+import "time"
+
+// One authenticated final reply per peer. The fixed deadline and generation
+// prevent duplicates from extending a key lifetime or reinstalling an old key.
+// Access is serialized by Server.stateMu, like the other handshake state.
+type confirmedReply struct {
+	request    initConf
+	handshake  *responderHandshake
+	deadline   time.Time
+	generation uint64
+	completed  bool
+}
+
+func (s *Server) handleConfirmedReply(req *initConf, from Endpoint) error {
+	now := time.Now()
+	for _, p := range s.peers {
+		cached := p.confirmedReply
+		if cached == nil {
+			continue
+		}
+		if !now.Before(cached.deadline) || cached.generation != p.generation {
+			p.confirmedReply = nil
+			continue
+		}
+		// Match the entire already-authenticated request, including its MAC. Never
+		// relax the biscuit replay checks for a different request or transcript.
+		if cached.request == *req {
+			return s.deliverConfirmedReply(cached, from)
+		}
+	}
+	hs := &responderHandshake{handshake: handshake{server: s}}
+	if err := hs.handleInitConf(req); err != nil {
+		return err
+	}
+	cached := &confirmedReply{request: *req, handshake: hs, deadline: now.Add(RejectAfterTime), generation: hs.peer.generation}
+	hs.peer.confirmedReply = cached
+	return s.deliverConfirmedReply(cached, from)
+}
+
+func (s *Server) deliverConfirmedReply(cached *confirmedReply, from Endpoint) error {
+	if err := cached.handshake.sendEmptyData(from); err != nil {
+		return err
+	}
+	if !cached.completed {
+		s.completeHandshake(&cached.handshake.handshake, from, RekeyAfterTimeResponder)
+		cached.completed = true
+		cached.generation = cached.handshake.peer.generation
+		cached.handshake.peer.confirmedReply = cached
+	}
+	return nil
+}
