+// QuantumEvidence is local key-installation evidence, not remote attestation or
+// a claim that the entire protocol provides NIST category 5 security.
+func (h *NetbirdHandler) QuantumEvidence(pid rp.PeerID) (string, string, string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	p, ok := h.peers[pid]
+	if !ok || p.installedAt.IsZero() || !time.Now().Before(p.expiresAt) {
+		return "", "", ""
+	}
+	installer, ok := h.iface.(quantumKeyInstaller)
+	if !ok || !installer.QuantumSessionReady(wgtypes.Key(p.PublicKey).String()) {
+		return "", "", ""
+	}
+	return "nexal-mlkem1024-tcp-v2", p.installedAt.Format(time.RFC3339Nano), p.expiresAt.Format(time.RFC3339Nano)
+}
+
+func (h *NetbirdHandler) revokeQuantumLocked(p *wireGuardPeer) {
+	if installer, ok := h.iface.(quantumKeyInstaller); ok {
+		installer.RevokeQuantum(wgtypes.Key(p.PublicKey).String())
+	}
+}
