+// TCPBudget bounds one control delivery: the dial, the frame write and the
+// wait for the receiver's EOF receipt. Direct peers get a short budget so an
+// unreachable peer stalls the server briefly; relayed peers get more time.
+type TCPBudget struct {
+	Dial, Write, Receipt time.Duration
+}
+
+var (
+	DirectTCPBudget  = TCPBudget{Dial: 3 * time.Second, Write: 3 * time.Second, Receipt: 3 * time.Second}
+	RelayedTCPBudget = TCPBudget{Dial: 6 * time.Second, Write: 5 * time.Second, Receipt: 6 * time.Second}
