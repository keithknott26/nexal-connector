+
+// ConfigureQuantumControl and InstallQuantumKey require the userspace session
+// gate; kernel WireGuard cannot silently bypass it in this experimental profile.
+func (w *WGIface) ConfigureQuantumControl(peerKey, remoteIP string, localPort, remotePort uint16) error {
+	key, err := wgtypes.ParseKey(peerKey)
+	if err != nil {
+		return err
+	}
+	remote, err := netip.ParseAddr(remoteIP)
+	if err != nil {
+		return err
+	}
+	d := w.GetWGDevice()
+	if d == nil {
+		return fmt.Errorf("quantum session gate requires userspace WireGuard")
+	}
+	return d.ConfigureQuantumControl([32]byte(key), w.Address().IP, remote, localPort, remotePort)
+}
+func (w *WGIface) InstallQuantumKey(peerKey string, psk wgtypes.Key, expires time.Time) error {
+	key, err := wgtypes.ParseKey(peerKey)
+	if err != nil {
+		return err
+	}
+	d := w.GetWGDevice()
+	if d == nil {
+		return fmt.Errorf("quantum session gate requires userspace WireGuard")
+	}
+	return d.InstallQuantumKey([32]byte(key), [32]byte(psk), expires)
+}
+func (w *WGIface) RevokeQuantum(peerKey string) {
+	key, err := wgtypes.ParseKey(peerKey)
+	if err != nil {
+		return
+	}
+	if d := w.GetWGDevice(); d != nil {
+		d.RevokeQuantum([32]byte(key))
+	}
+}
+func (w *WGIface) QuantumSessionReady(peerKey string) bool {
+	key, err := wgtypes.ParseKey(peerKey)
+	if err != nil {
+		return false
+	}
+	d := w.GetWGDevice()
+	return d != nil && d.QuantumSessionReady([32]byte(key))
+}
