+// failInstallLocked closes the gate after an exchange whose key could not be
+// installed: nothing may stay admitted under a key the peers no longer share.
+func (h *NetbirdHandler) failInstallLocked(peer *wireGuardPeer) {
+	h.revokeQuantumLocked(peer)
+	peer.installedAt = time.Time{}
+	peer.expiresAt = time.Time{}
+	peer.reason = ReasonKeyInstallFailed
+}
