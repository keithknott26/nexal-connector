# neXal storage: the managed dev-container runner (see README.md in this directory).
# Install as /etc/systemd/system/nexal-storage.service.
[Unit]
Description=neXal storage managed dev-container runner
# juicefs-nexal-storage is only installed on the S3-backed workspace backend; a missing
# unit in Wants/After is simply ignored, so this line is harmless on a local-disk host.
After=network-online.target docker.service juicefs-nexal-storage.service
Wants=network-online.target
Wants=juicefs-nexal-storage.service
Requires=docker.service

[Service]
Type=simple
User=nexal
Group=nexal
# The connector talks to the Docker Engine; the docker group is root-equivalent on
# this host, which is why the host runs nothing but this service and the gateway.
SupplementaryGroups=docker
Environment=HOME=/var/lib/nexal
Environment=NEXAL_MANAGED_RUNNER=1
Environment=NEXAL_MANAGED_STATE_DIR=/var/lib/nexal
Environment=NEXAL_MANAGED_HOSTING=/etc/nexal/sandbox-hosting.json
Environment=NEXAL_SECRETS_DIR=/var/lib/nexal/secrets
# Per-tenant slices go under nexal-tenants.slice (see nexal-tenants.slice).
Environment=NEXAL_MANAGED_SLICE=nexal-tenants
# Set to 1 only if /var/lib/docker is overlay2 on xfs mounted with pquota, and only
# on the local-disk workspace backend -- it has no effect over JuiceFS (see
# setup-storage-backend.sh and README.md, "Storage backend").
Environment=NEXAL_MANAGED_STORAGE_OPT=0
ExecStart=/usr/local/bin/nexal run --config /etc/nexal/config.json
Restart=on-failure
RestartSec=5
StateDirectory=nexal nexal/secrets
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nexal /etc/nexal
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
