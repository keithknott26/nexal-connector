+// SPDX-License-Identifier: Apache-2.0
+package rosenpass
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"sync"
+	"time"
+)
+
+// TCPConn carries the existing authenticated envelopes over bounded TCP frames.
+// Endpoints must be explicitly authorized from the management peer inventory.
+// TCP segmentation avoids reliance on IP fragmentation for large ML-KEM keys.
+// The transport itself is NOT authentication: envelope verification is mandatory.
+type TCPConn struct {
+	Listen      func(string, string) (net.Listener, error)
+	DialContext func(context.Context, string, string) (net.Conn, error)
+	listen      string
+	mu          sync.Mutex
+	listener    net.Listener
+	allowed     map[string]bool
+	active      map[net.Conn]bool
+	incoming    chan tcpFrame
+	done        chan struct{}
+	once        sync.Once
+	slots       chan struct{}
+}
+type tcpFrame struct {
+	data     []byte
+	endpoint *UDPEndpoint
+}
+
+const tcpFrameLimit = 4096
+
+func NewTCPConn(listen string) *TCPConn {
+	return &TCPConn{listen: listen, allowed: map[string]bool{}, active: map[net.Conn]bool{}, incoming: make(chan tcpFrame, 64), done: make(chan struct{}), slots: make(chan struct{}, 32)}
+}
+func (c *TCPConn) AuthorizeEndpoint(addr *net.UDPAddr, allowed bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if allowed {
+		c.allowed[addr.String()] = true
+	} else {
+		delete(c.allowed, addr.String())
+	}
+}
+func (c *TCPConn) authorized(addr *net.UDPAddr) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.allowed[addr.String()]
+}
+func (c *TCPConn) Open() ([]ReceiveFunc, error) {
+	listen := c.Listen
+	if listen == nil {
+		listen = net.Listen
+	}
+	l, err := listen("tcp", c.listen)
+	if err != nil {
+		return nil, err
+	}
+	c.mu.Lock()
+	c.listener = l
+	c.mu.Unlock()
+	go c.accept(l)
+	return []ReceiveFunc{func(key spk) (payload, Endpoint, error) {
+		select {
+		case <-c.done:
+			return nil, nil, net.ErrClosed
+		case f := <-c.incoming:
+			if !c.authorized((*net.UDPAddr)(f.endpoint)) {
+				return nil, nil, errors.New("revoked control endpoint")
+			}
+			e := &envelope{}
+			n, err := e.CheckAndUnmarshalBinary(f.data, key)
+			if err != nil {
+				return nil, nil, err
+			}
+			if n != len(f.data) {
+				return nil, nil, errors.New("partial envelope")
+			}
+			return e.payload, f.endpoint, nil
+		}
+	}}, nil
+}
+func (c *TCPConn) accept(l net.Listener) {
+	for {
+		conn, err := l.Accept()
+		if err != nil {
+			return
+		}
+		select {
+		case c.slots <- struct{}{}:
+		default:
+			conn.Close()
+			continue
+		}
+		c.mu.Lock()
+		select {
+		case <-c.done:
+			c.mu.Unlock()
+			conn.Close()
+			<-c.slots
+			return
+		default:
+		}
+		c.active[conn] = true
+		c.mu.Unlock()
+		go func() {
+			defer func() { conn.Close(); c.mu.Lock(); delete(c.active, conn); c.mu.Unlock(); <-c.slots }()
+			conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+			var header [8]byte
+			if _, err := io.ReadFull(conn, header[:]); err != nil {
+				return
+			}
+			if string(header[:4]) != "NXQ2" {
+				return
+			}
+			n := int(binary.BigEndian.Uint16(header[4:6]))
+			port := int(binary.BigEndian.Uint16(header[6:8]))
+			if n < 1 || n > tcpFrameLimit || port == 0 {
+				return
+			}
+			remote := conn.RemoteAddr().(*net.TCPAddr)
+			addr := &net.UDPAddr{IP: remote.IP, Port: port, Zone: remote.Zone}
+			if !c.authorized(addr) {
+				return
+			}
+			data := make([]byte, n)
+			if _, err := io.ReadFull(conn, data); err != nil {
+				return
+			}
+			select {
+			case c.incoming <- tcpFrame{data, (*UDPEndpoint)(addr)}:
+			case <-c.done:
+			default:
+			}
+		}()
+	}
+}
+func (c *TCPConn) Send(pl payload, key spk, ep Endpoint) error {
+	addr, ok := ep.(*UDPEndpoint)
+	if !ok || addr == nil {
+		return errInvalidEndpoint
+	}
+	if !c.authorized((*net.UDPAddr)(addr)) {
+		return errors.New("unauthorized control endpoint")
+	}
+	e := envelope{payload: pl}
+	switch pl.(type) {
+	case *initHello:
+		e.typ = msgTypeInitHello
+	case *respHello:
+		e.typ = msgTypeRespHello
+	case *initConf:
+		e.typ = msgTypeInitConf
+	case *emptyData:
+		e.typ = msgTypeEmptyData
+	default:
+		return errors.New("unsupported envelope")
+	}
+	data := e.MarshalBinaryAndSeal(key)
+	if len(data) > tcpFrameLimit {
+		return errors.New("control envelope too large")
+	}
+	c.mu.Lock()
+	l := c.listener
+	c.mu.Unlock()
+	if l == nil {
+		return net.ErrClosed
+	}
+	select {
+	case <-c.done:
+		return net.ErrClosed
+	default:
+	}
+	dial := c.DialContext
+	if dial == nil {
+		dial = (&net.Dialer{}).DialContext
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	conn, err := dial(ctx, "tcp", addr.String())
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	conn.SetWriteDeadline(time.Now().Add(2 * time.Second))
+	frame := make([]byte, 8+len(data))
+	copy(frame, "NXQ2")
+	binary.BigEndian.PutUint16(frame[4:6], uint16(len(data)))
+	binary.BigEndian.PutUint16(frame[6:8], uint16(l.Addr().(*net.TCPAddr).Port))
+	copy(frame[8:], data)
+	for len(frame) > 0 {
+		n, err := conn.Write(frame)
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+		frame = frame[n:]
+	}
+	return nil
+}
+func (c *TCPConn) LocalEndpoints() ([]Endpoint, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.listener == nil {
+		return nil, net.ErrClosed
+	}
+	a := c.listener.Addr().(*net.TCPAddr)
+	return []Endpoint{(*UDPEndpoint)(&net.UDPAddr{IP: a.IP, Port: a.Port, Zone: a.Zone})}, nil
+}
+func (c *TCPConn) Close() error {
+	var err error
+	c.once.Do(func() {
+		close(c.done)
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		if c.listener != nil {
+			err = c.listener.Close()
+		}
+		for conn := range c.active {
+			conn.Close()
+		}
+	})
+	return err
+}
+
+// NewTCPServer takes ownership of a supplied bounded TCP control transport.
+func NewTCPServer(cfg Config, conn *TCPConn) (*Server, error) {
+	if conn == nil {
+		return nil, fmt.Errorf("missing TCP control transport")
+	}
+	cfg.Conn = conn
+	cfg.closeConn = true
+	s, err := NewServer(cfg)
+	if err != nil {
+		conn.Close()
+	}
+	return s, err
+}
