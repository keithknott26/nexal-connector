+// SPDX-License-Identifier: MIT
+package device
+
+import (
+	"encoding/binary"
+	"errors"
+	"net/netip"
+	"time"
+)
+
+// This gate is opt-in on a userspace Device and applies to every peer and packet
+// path, including CreateOutboundPacket used by forwarding. It does not alter
+// WireGuard's wire protocol or advertise product-level NIST certification.
+type quantumLease struct {
+	generation            uint64
+	expires               time.Time
+	local, remote         netip.Addr
+	localPort, remotePort uint16
+}
+
+func (d *Device) RequireQuantum() { d.quantumRequired.Store(true) }
+func (d *Device) ConfigureQuantumControl(key [32]byte, local, remote netip.Addr, localPort, remotePort uint16) error {
+	p := d.LookupPeer(NoisePublicKey(key))
+	if p == nil {
+		return errors.New("quantum peer does not exist")
+	}
+	p.handshake.mutex.Lock()
+	defer p.handshake.mutex.Unlock()
+	old := p.quantum.Load()
+	next := quantumLease{}
+	if old != nil {
+		next.generation = old.generation + 1
+	}
+	next.local = local.Unmap()
+	next.remote = remote.Unmap()
+	next.localPort = localPort
+	next.remotePort = remotePort
+	p.quantum.Store(&next)
+	return nil
+}
+
+// InstallQuantumKey creates a new generation under the same lock as the PSK.
+// Only a WireGuard session derived using that generation may carry app data.
+func (d *Device) InstallQuantumKey(key, psk [32]byte, expires time.Time) error {
+	if !d.quantumRequired.Load() {
+		return errors.New("quantum gate is not enabled")
+	}
+	if !expires.After(time.Now()) || time.Until(expires) > 3*time.Minute {
+		return errors.New("invalid quantum key lifetime")
+	}
+	p := d.LookupPeer(NoisePublicKey(key))
+	if p == nil {
+		return errors.New("quantum peer does not exist")
+	}
+	p.handshake.mutex.Lock()
+	old := p.quantum.Load()
+	if old == nil || !old.local.IsValid() || !old.remote.IsValid() || old.localPort == 0 || old.remotePort == 0 {
+		p.handshake.mutex.Unlock()
+		return errors.New("control endpoint not configured")
+	}
+	next := *old
+	next.generation++
+	next.expires = time.Now().Add(time.Until(expires))
+	p.handshake.presharedKey = NoisePresharedKey(psk)
+	p.quantum.Store(&next)
+	p.handshake.mutex.Unlock()
+	p.ExpireCurrentKeypairs()
+	return nil
+}
+func (p *Peer) invalidateQuantumLocked() {
+	old := p.quantum.Load()
+	if old == nil {
+		return
+	}
+	next := *old
+	next.generation++
+	next.expires = time.Time{}
+	p.quantum.Store(&next)
+}
+func (d *Device) RevokeQuantum(key [32]byte) {
+	if p := d.LookupPeer(NoisePublicKey(key)); p != nil {
+		p.handshake.mutex.Lock()
+		p.invalidateQuantumLocked()
+		p.handshake.mutex.Unlock()
+	}
+}
+func (d *Device) QuantumSessionReady(key [32]byte) bool {
+	p := d.LookupPeer(NoisePublicKey(key))
+	if p == nil || !d.quantumRequired.Load() {
+		return false
+	}
+	return p.quantumKeyReady(p.keypairs.Current(), time.Now())
+}
+func (p *Peer) quantumKeyReady(key *Keypair, now time.Time) bool {
+	s := p.quantum.Load()
+	return s != nil && key != nil && s.generation != 0 && key.quantumGeneration == s.generation && now.Before(s.expires)
+}
+
+// quantumAllows runs on plaintext before encryption and after authenticated
+// decryption. Old sessions remain usable solely for the bounded control channel.
+func (p *Peer) quantumAllows(packet []byte, key *Keypair, outbound bool) bool {
+	if !p.device.quantumRequired.Load() || len(packet) == 0 {
+		return true
+	}
+	if p.quantumKeyReady(key, time.Now()) {
+		return true
+	}
+	s := p.quantum.Load()
+	if s == nil {
+		return false
+	}
+	return s.controlPacket(packet, outbound)
+}
+func (s *quantumLease) controlPacket(packet []byte, outbound bool) bool {
+	// No fragments, IPv6 extension headers, IP options or non-TCP bootstrap data.
+	var src, dst netip.Addr
+	var tcp []byte
+	if len(packet) >= 40 && packet[0]>>4 == 6 {
+		n := int(binary.BigEndian.Uint16(packet[4:6])) + 40
+		if packet[6] != 6 || n > len(packet) || n < 60 {
+			return false
+		}
+		src = netip.AddrFrom16([16]byte(packet[8:24]))
+		dst = netip.AddrFrom16([16]byte(packet[24:40]))
+		tcp = packet[40:n]
+	} else if len(packet) >= 20 && packet[0] == 0x45 {
+		n := int(binary.BigEndian.Uint16(packet[2:4]))
+		if packet[9] != 6 || binary.BigEndian.Uint16(packet[6:8])&0x3fff != 0 || n > len(packet) || n < 40 {
+			return false
+		}
+		src = netip.AddrFrom4([4]byte(packet[12:16]))
+		dst = netip.AddrFrom4([4]byte(packet[16:20]))
+		tcp = packet[20:n]
+	} else {
+		return false
+	}
+	if len(tcp) < 20 || int(tcp[12]>>4)*4 < 20 || int(tcp[12]>>4)*4 > len(tcp) {
+		return false
+	}
+	sp, dp := binary.BigEndian.Uint16(tcp[:2]), binary.BigEndian.Uint16(tcp[2:4])
+	if outbound {
+		return src.Unmap() == s.local && dst.Unmap() == s.remote && ((s.remotePort != 0 && dp == s.remotePort) || (s.localPort != 0 && sp == s.localPort))
+	}
+	return src.Unmap() == s.remote && dst.Unmap() == s.local && ((s.localPort != 0 && dp == s.localPort) || (s.remotePort != 0 && sp == s.remotePort))
+}
