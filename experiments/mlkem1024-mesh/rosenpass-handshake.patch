+// tieBreakWindow bounds how long a winning initiator ignores the peer's
+// crossing InitHello: past it the attempt is considered stalled and the peer's
+// exchange is served instead.
+var tieBreakWindow = 10 * time.Second
+
+// yieldToPeerInitiationLocked decides what to do with a peer's InitHello when
+// we have an initiator exchange of our own in flight (both ends started at the
+// same time). Two complete exchanges would install two different keys in
+// opposite orders on the two ends, so exactly one may complete: the end with
+// the lower peer ID is the initiator of record. It returns true if the
+// InitHello should be answered. Called with stateMu held.
+func (s *Server) yieldToPeerInitiationLocked(p *peer) bool {
+	cur := p.current
+	if cur == nil {
+		return true
+	}
+	local := s.PID()
+	if bytes.Compare(local[:], func() []byte { id := p.PID(); return id[:] }()) < 0 {
+		// We win: keep our exchange unless it has stalled before the peer
+		// answered; an exchange past RespHello is about to complete and cannot
+		// be abandoned without stranding the peer.
+		if cur.nextMsg == msgTypeRespHello && time.Since(cur.startedAt) > tieBreakWindow {
+			s.abortHandshakeLocked(p)
+			return true
+		}
+		return false
+	}
