+// SPDX-License-Identifier: Apache-2.0
+package rosenpass
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"log/slog"
+	"math"
+	"time"
+)
+
+// Per-peer initiation backoff. A failed initiation (the bounded TCP control
+// frame could not be delivered) no longer leaves a handshake retransmitting
+// every few seconds for RejectAfterTime; the attempt is torn down and the next
+// one is scheduled with exponential growth and jitter. Success resets the
+// counter. The WireGuard session gate is untouched: an expired lease still
+// denies application traffic no matter how the retries are paced.
+var (
+	// InitiationBackoffBase is the delay after the first consecutive failure; it
+	// doubles with every further failure.
+	InitiationBackoffBase = 2 * time.Second
+	// InitiationBackoffCap bounds the delay toward a peer without a live lease (30 s: recover soon after a path comes back).
+	InitiationBackoffCap = 30 * time.Second
+	// RenewalBackoffCap bounds the delay while the current lease is still live,
+	// so a renewal gets many attempts inside the margin before the lease expires.
+	RenewalBackoffCap = 15 * time.Second
+	// InitiationBackoffJitter is the symmetric relative jitter (0.2 = +/-20 %).
+	InitiationBackoffJitter = 0.2
+)
+
+// HandshakeFailedHandler is told when an initiation toward a peer failed and
+// when the next attempt is scheduled. The error is a transport error; nothing
+// about the peer's identity has been verified at that point.
+type HandshakeFailedHandler interface {
+	HandshakeFailed(pid, error, time.Duration)
+}
+
+// backoffDelay returns InitiationBackoffBase * 2^(failures-1), capped at limit,
+// with +/- InitiationBackoffJitter relative jitter.
+func backoffDelay(failures uint, limit time.Duration) time.Duration {
+	if failures == 0 {
+		failures = 1
+	}
+	exp := float64(failures - 1)
+	if exp > 40 {
+		exp = 40
+	}
+	d := float64(InitiationBackoffBase) * math.Pow(2, exp)
+	if d > float64(limit) {
+		d = float64(limit)
+	}
+	var b [8]byte
+	if _, err := rand.Read(b[:]); err == nil {
+		f := float64(binary.BigEndian.Uint64(b[:])>>11) / float64(1<<53) // [0,1)
+		d *= 1 + InitiationBackoffJitter*(2*f-1)
+	}
+	if d < float64(time.Millisecond) {
+		d = float64(time.Millisecond)
+	}
+	return time.Duration(d)
+}
+
+// Called with stateMu held.
+func (s *Server) failInitiationLocked(p *peer, err error) {
+	p.failures++
+	limit := InitiationBackoffCap
+	if time.Now().Before(p.leaseExpires) {
+		limit = RenewalBackoffCap
+	}
+	delay := backoffDelay(p.failures, limit)
+	attrs := []any{slog.Any("error", err), slog.Uint64("failures", uint64(p.failures)), slog.Duration("retry_in", delay)}
+	if p.failures == 1 {
+		p.logger.Warn("Failed to initiate handshake; backing off", attrs...)
+	} else {
+		p.logger.Debug("Failed to initiate handshake; backing off", attrs...)
+	}
+	for _, h := range s.handlers {
+		if h, ok := h.(HandshakeFailedHandler); ok {
+			h.HandshakeFailed(p.PID(), err, delay)
+		}
+	}
+	s.schedulePeerHandshake(p, delay)
+	s.armPeerExpiryLocked(p)
+}
+
+// abortHandshakeLocked tears down the peer's in-flight initiator handshake
+// without reporting it. Called with stateMu held.
+func (s *Server) abortHandshakeLocked(p *peer) {
+	hs := p.current
+	if hs == nil {
+		return
+	}
+	p.current = nil
+	hs.Close()
+	s.removeHandshake(hs)
+}
+
+// abortHandshake is used from retransmission callbacks (which never hold
+// stateMu): the in-flight attempt could not be delivered any more.
+func (s *Server) abortHandshake(hs *initiatorHandshake, err error) {
+	s.stateMu.Lock()
+	defer s.stateMu.Unlock()
+	p := hs.peer
+	if s.closed || s.peers[p.PID()] != p || p.current != hs {
+		return
+	}
+	s.abortHandshakeLocked(p)
+	s.failInitiationLocked(p, err)
+}
+
+// armPeerExpiryLocked starts the peer-level lease/outage timer if none runs.
+// It fires RejectAfterTime after a completed exchange (the lease end) or after
+// the first failed attempt without a lease, and re-arms itself afterwards, so
+// HandshakeExpired keeps its upstream cadence independently of how often the
+// individual attempts are retried. Called with stateMu held.
+func (s *Server) armPeerExpiryLocked(p *peer) {
+	if p.expiryTimer != nil {
+		return
+	}
+	generation := p.generation
+	p.expiryTimer = time.AfterFunc(RejectAfterTime, func() { s.expirePeer(p, generation) })
+}
+
+func (s *Server) expirePeer(p *peer, generation uint64) {
+	s.stateMu.Lock()
+	defer s.stateMu.Unlock()
+	if s.closed || s.peers[p.PID()] != p {
+		return
+	}
+	p.expiryTimer = nil
+	if generation != p.generation {
+		return
+	}
+	s.abortHandshakeLocked(p)
+	p.leaseExpires = time.Time{}
+	p.logger.Debug("Erasing outdated key from peer")
+	for _, h := range s.handlers {
+		if h, ok := h.(HandshakeExpiredHandler); ok {
+			h.HandshakeExpired(p.PID())
+		}
+	}
+	s.armPeerExpiryLocked(p)
+	if p.endpoint != nil && p.nextAttempt.After(time.Now().Add(RetransmitDelayEnd)) {
+		// Both ends just converged on the replacement key; pull a distant retry
+		// forward. An earlier attempt is kept, and the failure counter is kept
+		// so later failures keep growing.
+		s.schedulePeerHandshake(p, RetransmitDelayEnd)
+	}
+}
