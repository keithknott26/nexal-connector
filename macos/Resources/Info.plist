<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>es</string>
    <string>fr</string>
    <string>de</string>
    <string>it</string>
    <string>pt-BR</string>
    <string>nl</string>
    <string>sv</string>
    <string>pl</string>
    <string>tr</string>
    <string>ru</string>
    <string>uk</string>
    <string>ar</string>
    <string>he</string>
    <string>hi</string>
    <string>ja</string>
    <string>ko</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
    <string>id</string>
    <string>vi</string>
  </array>
  <key>CFBundleIdentifier</key><string>systems.nexal.connector</string>
  <key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleExecutable</key><string>NexalMac</string>
  <key>CFBundleName</key><string>neXal@home</string>
  <key>CFBundleDisplayName</key><string>neXal@home</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.4.1</string>
  <key>CFBundleVersion</key><string>10</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
	<!-- Reading another Mac's model throughput is plain http, but only to neXal-network addresses, which the
	     mesh already encrypts. Local networking covers IP addresses; the exception covers the mesh names. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>mesh.nexal.systems</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
